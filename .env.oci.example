# ==========================================
# Produção (OCI) — variáveis do Agente de IA
# Copie para .env no VM e preencha os CHANGE_ME
# ==========================================

# Banco (hostname = nome do serviço postgres no compose)
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@postgres:5432/grindx

# LLM (DeepSeek)
LLM_API_KEY=CHANGE_ME
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Recuperação
SIMILARITY_THRESHOLD=0.35
TOP_K=3

# CORS — origem do frontend GrindX em produção
CORS_ORIGINS=https://app.seudominio.com

# Postgres container
POSTGRES_PASSWORD=CHANGE_ME
